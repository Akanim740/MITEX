# ===== Server =====
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ===== Database =====
# sqlite | mysql | mongo | supabase | firebase
DB_CLIENT=sqlite
DB_FILE=./data/mitex.db

# --- MySQL (DB_CLIENT=mysql) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=mitex

# --- MongoDB (DB_CLIENT=mongo) ---
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=mitex

# --- Supabase (DB_CLIENT=supabase) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Firebase (DB_CLIENT=firebase) ---
FIREBASE_SERVICE_ACCOUNT=

# ===== Auth / Sessions =====
JWT_ACCESS_SECRET=replace-with-a-long-random-string
ACCESS_TTL=15m
REFRESH_TTL_DAYS=7

# ===== Biometric login (WebAuthn passkeys) =====
# Optional - defaults to the hostname in APP_URL (e.g. localhost).
# In production set this to your real domain, e.g. mitex.store
WEBAUTHN_RP_ID=

# ===== Seed admin =====
ADMIN_NAME=MITEX Admin
ADMIN_EMAIL=admin@mitex.store
ADMIN_PASSWORD=ChangeMe123!

# ===== Email (optional - links are logged to console when empty) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MITEX <no-reply@mitex.store>

# ===== Payments (Paystack) =====
# Leave PAYSTACK_SECRET_KEY empty to use demo checkout (simulated payments).
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

# ============================================================
# PRODUCTION (Render + Supabase) - set these in the Render dashboard
# ============================================================
# NODE_ENV=production
# SEED_ON_BOOT=true          # creates admin + 23 listings on first boot (idempotent)
#
# --- Database ---
# DB_CLIENT=supabase
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_KEY=your-service-role-key   (Settings > API > service_role)
#
# --- Auth ---
# JWT_ACCESS_SECRET=long-random-string       (render.yaml generates one automatically)
#
# --- Biometric login - MUST equal your site's exact domain ---
# WEBAUTHN_RP_ID=mitex.store                 (or mitex.onrender.com before custom domain)
