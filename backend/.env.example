# ===== Server =====
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
# Canonical origin for SEO tags (canonical, og:url), robots.txt and sitemap.xml.
# Set this to the host visitors actually use once you have a custom domain;
# leaving it unset falls back to APP_URL. Example: SEO_BASE_URL=https://mitex.store
SEO_BASE_URL=
CORS_ORIGIN=http://localhost:3000
# Trust one proxy hop (Real IPs for rate limiting). Defaults to 1 in production
# (Render's edge sets X-Forwarded-For); keep 0 locally with no proxy in front.
# TRUST_PROXY=1

# ===== Database =====
# sqlite | mysql | mongo | supabase | firebase
DB_CLIENT=sqlite
DB_FILE=./data/mitex.db

# --- MySQL (DB_CLIENT=mysql) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=mitex

# --- MongoDB (DB_CLIENT=mongo) ---
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=mitex

# --- Supabase (DB_CLIENT=supabase) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Firebase (DB_CLIENT=firebase) ---
FIREBASE_SERVICE_ACCOUNT=

# ===== Auth / Sessions =====
JWT_ACCESS_SECRET=replace-with-a-long-random-string
ACCESS_TTL=15m
REFRESH_TTL_DAYS=7
# Per-account sign-in lockout (in addition to the per-IP rate limiter).
# 5 wrong passwords -> locked for 15 minutes. Raise LOGIN_LOCK_MIN on a
# shared/public device so a neighbour's typos can't lock the real user out.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MIN=15

# ===== Biometric login (WebAuthn passkeys) =====
# Optional - defaults to the hostname in APP_URL (e.g. localhost).
# In production set this to your real domain, e.g. mitex.store
WEBAUTHN_RP_ID=

# ===== Seed admin =====
ADMIN_NAME=MITEX Admin
ADMIN_EMAIL=admin@mitex.store
ADMIN_PASSWORD=ChangeMe123!

# ===== Email (optional - links are logged to console when empty) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MITEX <no-reply@mitex.store>

# ===== Payments (Paystack) =====
# Leave PAYSTACK_SECRET_KEY empty to use demo checkout (simulated payments).
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

# ============================================================
# PRODUCTION (Render + Supabase) - set these in the Render dashboard
# ============================================================
# NODE_ENV=production
# SEED_ON_BOOT=true          # creates admin + 23 listings on first boot (idempotent)
#
# --- Database ---
# DB_CLIENT=supabase
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_KEY=your-service-role-key   (Settings > API > service_role)
#
# --- Auth ---
# JWT_ACCESS_SECRET=long-random-string       (render.yaml generates one automatically)
#
# --- Biometric login - MUST equal your site's exact domain ---
# WEBAUTHN_RP_ID=mitex.store                 (or mitex.onrender.com before custom domain)

  # --- MITEX AI (server-side only, never expose to the browser) ---
  # The assistant and the tour-guide concierge use the FIRST provider below
  # that has a key; only when none is set do the offline fallbacks reply.
  #
  # Option 1: OpenRouter - one key, many models, free-tier variants. Costs $0
  #   with a :free model. Key: openrouter.ai > Keys. Model list: openrouter.ai/models
  # OPENROUTER_API_KEY=sk-or-...
  # OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
  #
  # Option 2: Google Gemini - generous free tier. Key: aistudio.google.com > Get API key
  # GEMINI_API_KEY=AIza-...
  # GEMINI_MODEL=gemini-2.0-flash
  #
  # Option 3: Anthropic (original integration)
  # ANTHROPIC_API_KEY=sk-ant-...        (console.anthropic.com > Settings > API Keys)
  # ANTHROPIC_MODEL=claude-sonnet-4-5    (alias: always current snapshot)
  # AI_MAX_TOKENS=16000                  (default output cap)
  # AI_BUILD_MAX_TOKENS=32000            (per website build)
  # AI_TIMEOUT_MS=180000
